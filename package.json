{
  "name": "chefsergioandco",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "build": "npm run build:client && npm run build:ssr && npm run prerender && npm run check",
    "build:prod": "SITE_MODE=production npm run build:client && SITE_MODE=production npm run build:ssr && SITE_MODE=production npm run prerender && SITE_MODE=production npm run check",
    "check": "node scripts/check-prerender.mjs && node scripts/check-ssr-visibility.mjs && node scripts/check-menu.mjs && node scripts/check-images.mjs && node scripts/check-seo.mjs && node scripts/check-placeholders.mjs && node scripts/check-staging-target.mjs",
    "check:ui": "node scripts/navigation-affordances-check.mjs && node scripts/check-deferred-images.mjs",
    "check:motion": "node scripts/selected-motion-check.mjs",
    "check:depth": "node scripts/depth-inertia-check.mjs",
    "check:navigation": "node scripts/navigation-motion-check.mjs",
    "check:next-page": "node scripts/next-page-check.mjs",
    "audit": "node scripts/audit.mjs && node scripts/flow-test.mjs && node scripts/audit-looks.mjs && node scripts/hero-check.mjs",
    "refs": "node scripts/watermark.mjs",
    "og": "node scripts/og-cards.mjs --force",
    "schema:vocab": "node scripts/schema-vocab.mjs",
    "preview": "node scripts/serve.mjs",
    "check:booking": "node scripts/check-booking-client.mjs && node scripts/check-quick-booking.mjs && node scripts/check-invitation-menu.mjs && node scripts/check-draft-restoration.mjs",
    "check:account": "node scripts/check-staging-account.mjs",
    "check:types": "tsc --noEmit",
    "check:account-export": "node scripts/check-account-export.mjs",
    "check:referrals": "node scripts/check-quick-referral.mjs"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "2.30.0",
    "@fontsource-variable/alegreya": "^5.1.0",
    "@fontsource-variable/archivo": "^5.1.0",
    "@fontsource-variable/bricolage-grotesque": "^5.1.0",
    "@fontsource/alegreya-sans": "^5.1.0",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-radio-group": "1.2.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@tiptap/core": "3.35.0",
    "@tiptap/extension-image": "3.35.0",
    "@tiptap/extension-text-align": "3.35.0",
    "@tiptap/extension-text-style": "3.35.0",
    "@tiptap/pm": "3.35.0",
    "@tiptap/react": "3.35.0",
    "@tiptap/starter-kit": "3.35.0",
    "framer-motion": "11.15.0",
    "pdf-lib": "1.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "axe-core": "4.10.2",
    "lighthouse": "12.3.0",
    "postcss": "8.4.49",
    "puppeteer-core": "23.11.1",
    "sharp": "0.33.5",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
